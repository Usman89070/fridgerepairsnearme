# Fridge Repairs Near Me — static hosting config (Apache / LiteSpeed, e.g. Hostinger)

# Serve pre-compressed content when the browser supports it
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Long-lived caching for hashed build assets, short caching for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Fallback any unknown path to index.html (single-page app safety net)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical URL: redirect anyone visiting /index.html directly to the
  # root, so there's only ever one indexable URL for the homepage.
  # THE_REQUEST (the original browser request line) is anchored to the
  # method at the very start — matching only "GET /index.html ..." —
  # so this never catches the SPA-fallback rule's internal rewrite to
  # /index.html, nor a request like /blog/index.html.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Clean sitemap URL, generated dynamically (includes blog posts)
  RewriteRule ^sitemap\.xml$ /api/sitemap.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

ErrorDocument 404 /index.html
